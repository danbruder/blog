<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-sm py-24">
    <h1 class="text-3xl text-sky-200 mb-6">Admin login</h1>

    <p :if={@error} class="mb-4 text-orange-300">{@error}</p>

    <.form :let={_f} for={%{}} as={:session} action={~p"/admin/login"} method="post">
      <div class="mb-4">
        <.label for="password">Password</.label>
        <input
          type="password"
          name="password"
          id="password"
          autofocus
          class="mt-1 block w-full rounded-lg bg-zinc-800 border-zinc-600 text-zinc-100 focus:border-sky-600 focus:ring-sky-600"
        />
      </div>
      <.button type="submit" class="w-full">Log in</.button>
    </.form>
  </div>
</div>
