<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <link rel="icon" href={~p"/images/favicon.png"} type="image/png" />

    <meta name="description" content={BlogWeb.SEO.description(assigns)} />
    <link rel="canonical" href={BlogWeb.SEO.canonical_url(assigns)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Dan Bruder"
      href={~p"/rss.xml"}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dan Bruder" />
    <meta property="og:title" content={BlogWeb.SEO.title(assigns)} />
    <meta property="og:description" content={BlogWeb.SEO.description(assigns)} />
    <meta property="og:url" content={BlogWeb.SEO.canonical_url(assigns)} />
    <meta property="og:image" content={BlogWeb.SEO.og_image()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={BlogWeb.SEO.title(assigns)} />
    <meta name="twitter:description" content={BlogWeb.SEO.description(assigns)} />
    <meta name="twitter:image" content={BlogWeb.SEO.og_image()} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Archivo:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <%!-- Set the theme before first paint so there's no flash. Light is the
          default; honor a saved choice, else the OS preference. --%>
    <script>
      (function () {
        var t = localStorage.theme ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = t;
      })();
    </script>

    <.live_title default="Dan Bruder | Engineering Director">
      {assigns[:page_title]}
    </.live_title>

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-screen">
    {@inner_content}
  </body>
</html>
