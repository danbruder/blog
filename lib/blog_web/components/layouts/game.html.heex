<div class="flex h-[100dvh] flex-col overflow-hidden bg-paper text-ink">
  <header class="shrink-0 border-b border-ink bg-paper">
    <div class="flex items-center justify-between px-4 py-3">
      <.link
        navigate={~p"/games"}
        class="label !text-ink-2 !shadow-none hover:!bg-lime hover:!text-on-lime"
      >
        ← Back
      </.link>
      <span class="font-display text-[15px] font-bold uppercase tracking-[-0.01em] text-ink">
        {assigns[:game_name]}
      </span>
      <span class="flex w-16 items-center justify-end gap-1.5 text-[11.5px] text-ink-2">
        <span :if={assigns[:viewer_count]} class="inline-block h-2 w-2 bg-lime"></span>
        <span :if={assigns[:viewer_count]}>{@viewer_count}</span>
      </span>
    </div>
  </header>

  <main class="min-h-0 flex-1 overflow-hidden">
    {@inner_content}
  </main>
</div>

<.flash_group flash={@flash} />
