<.flash_group flash={@flash} />

<% nav_items = [
  {"Writing", ~p"/writing", pad(length(Blog.Content.list_published_posts()))},
  {"Notes", ~p"/notes", pad(length(Blog.Content.list_published_notes()))},
  {"Podcasts", ~p"/podcasts", "01"},
  {"Projects", ~p"/projects", "—"},
  {"Games", ~p"/games", "02"}
] %>
<% current = assigns[:current_path] || "/" %>
<% active? = fn href ->
  cond do
    href == "/writing" -> current in ["/", "/writing"] or String.starts_with?(current, "/blog")
    true -> current == href or String.starts_with?(current, href <> "/")
  end
end %>

<div class="mx-auto grid min-h-screen max-w-[1180px] grid-cols-1 md:grid-cols-[244px_minmax(0,1fr)]">
  <aside class="border-b border-ink md:border-b-0 md:border-r bg-paper md:sticky md:top-0 md:h-screen md:self-start">
    <div class="flex h-full flex-col gap-8 px-7 py-6 md:py-8">
      <%!-- Brand --%>
      <div class="flex items-center justify-between gap-4 md:flex-col md:items-stretch">
        <.link
          navigate={~p"/"}
          class="flex items-center gap-3 !shadow-none hover:!bg-transparent md:block"
        >
          <img
            src={~p"/images/my-face-new.jpg"}
            alt="Dan Bruder"
            class="h-11 w-11 border border-ink object-cover object-[50%_20%] grayscale contrast-[1.1] md:mb-3 md:h-14 md:w-14"
          />
          <div>
            <div class="font-display text-[17px] font-bold tracking-[-0.025em] text-ink">
              DAN BRUDER
            </div>
            <div class="mt-1 hidden text-[12.5px] leading-[1.45] text-ink-3 md:block">
              Engineering director,<br />DroneDeploy.
            </div>
          </div>
        </.link>

        <button
          id="mobile-nav-toggle"
          phx-hook="MobileNav"
          type="button"
          class="text-2xl leading-none md:hidden"
          aria-label="Toggle navigation"
        >🍔</button>
      </div>

      <%!-- Everything below the brand collapses behind the 🍔 on mobile;
            on desktop it's the full-height nav + footer column. --%>
      <div id="mobile-nav" class="hidden flex-col gap-8 md:flex md:flex-1">
        <nav class="flex flex-col">
          <.link
            :for={{label, href, count} <- nav_items}
            navigate={href}
            class={[
              "-mx-2 flex items-baseline justify-between px-2 py-2 text-[13px] uppercase tracking-[0.08em] !shadow-none transition-colors",
              active?.(href) && "bg-paper-3 font-semibold !text-ink hover:!bg-paper-3",
              !active?.(href) && "font-medium !text-ink-2 hover:!bg-transparent hover:!text-ink"
            ]}
          >
            <span>{label}</span>
            <span class="text-[10.5px] text-ink-3">{count}</span>
          </.link>
        </nav>

        <div class="hidden flex-1 md:block"></div>

        <%!-- Viewers --%>
        <div
          :if={assigns[:viewer_count]}
          class="flex items-center gap-2 text-[11.5px] text-ink-2"
        >
          <span class="inline-block h-2 w-2 bg-lime"></span>
          {@viewer_count} reading now
        </div>

        <%!-- Secondary links --%>
        <div class="flex flex-col items-start gap-1.5 text-[12.5px] text-ink-2">
          <a href="/blog/about" class="!shadow-[inset_0_-1px_0_var(--color-rule)] !text-ink-2">
            About me
          </a>
          <a href={~p"/rss.xml"} class="!shadow-none !text-ink-2 hover:!text-on-lime">RSS</a>
          <a
            href="https://github.com/danbruder"
            class="!shadow-none !text-ink-2 hover:!text-on-lime"
          >
            GitHub
          </a>
        </div>

        <%!-- Footer: copyright + theme toggle --%>
        <div class="flex items-center justify-between border-t border-rule pt-3.5">
          <span class="text-[10.5px] uppercase tracking-[0.12em] text-ink-3">
            &copy; {Date.utc_today().year}
          </span>
          <button
            id="theme-toggle"
            phx-hook="ThemeToggle"
            type="button"
            class="border border-ink px-2 py-1 text-[10.5px] font-semibold uppercase tracking-[0.12em] text-ink transition-colors hover:bg-lime hover:text-on-lime"
          >
            Dark
          </button>
        </div>
      </div>
    </div>
  </aside>

  <main class="min-w-0 pb-28">
    {@inner_content}
  </main>
</div>
