<.flash_group flash={@flash} />

<% nav_items = [
  {"Writing", ~p"/writing", "✍️"},
  {"Notes", ~p"/notes", "🗒️"},
  {"Podcasts", ~p"/podcasts", "🎙️"},
  {"Projects", ~p"/projects", "🚧"},
  {"Games", ~p"/games", "🎮"}
] %>
<% current = assigns[:current_path] || "/" %>
<% active? = fn href ->
  cond do
    href == "/writing" -> current in ["/", "/writing"] or String.starts_with?(current, "/blog")
    true -> current == href or String.starts_with?(current, href <> "/")
  end
end %>

<div class="flex min-h-screen flex-col md:flex-row">
  <aside class="md:w-60 md:flex-shrink-0 md:border-r border-b md:border-b-0 border-zinc-800 bg-zinc-900">
    <div class="md:sticky md:top-0 flex flex-col md:h-screen">
      <%!-- Brand block: matches the hero band height and carries its own
            bottom border, so the divider lines up with the hero's border. --%>
      <div class="flex items-center justify-between gap-3 px-8 py-6 md:h-64 md:py-0 md:flex-col md:items-stretch md:justify-center md:border-b border-zinc-800">
        <.link navigate={~p"/"} class="flex items-center gap-3 md:block no-underline">
          <img
            class="w-10 h-10 md:w-24 md:h-24 block rounded-full object-cover md:mx-auto md:mb-3"
            src={~p"/images/my-face-new.jpg"}
            alt="Dan Bruder"
          />
          <span class="font-fancy text-lg md:text-2xl text-zinc-50 md:block md:text-center">Dan Bruder</span>
        </.link>

        <p class="mt-2 text-sm text-zinc-400 hidden md:block md:text-center">
          Engineering director at
          <a class="link" href="https://www.dronedeploy.com/">DroneDeploy</a>.
        </p>

        <button
          id="mobile-nav-toggle"
          phx-hook="MobileNav"
          type="button"
          class="md:hidden !border-0 !shadow-none text-2xl leading-none px-2"
          aria-label="Toggle navigation"
        >🍔</button>
      </div>

      <%!-- Nav block: begins at the brand border, so link hover zones line
            up with where the main content starts below the hero. --%>
      <div id="mobile-nav" class="hidden md:flex md:flex-1 flex-col px-6 pt-6">
        <nav class="flex flex-col gap-1">
          <.link
            :for={{label, href, emoji} <- nav_items}
            navigate={href}
            class={[
              "font-fancy px-3 py-2 rounded-lg no-underline",
              active?.(href) && "bg-zinc-800 text-[color:var(--accent-heading)]",
              !active?.(href) && "text-zinc-300 hover:bg-zinc-800/60"
            ]}
          >
            <span class="mr-2">{emoji}</span>{label}
          </.link>
        </nav>

        <div class="mt-6 md:mt-auto pt-6 text-xs text-zinc-500 flex flex-col gap-1">
          <div
            :if={assigns[:viewer_count]}
            class="mb-2 flex items-center gap-2 text-zinc-300"
          >
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-sky-400"></span>
            </span>
            {@viewer_count} {if @viewer_count == 1, do: "viewer", else: "viewers"}
          </div>
          <a class="text-zinc-400 no-underline hover:text-zinc-200" href="/blog/about">👋 about me</a>
          <a class="text-zinc-400 no-underline hover:text-zinc-200" href={~p"/rss.xml"}>RSS</a>
          <a class="text-zinc-400 no-underline hover:text-zinc-200" href="https://github.com/danbruder">GitHub</a>
          <span class="mt-2">&copy; {Date.utc_today().year} Dan Bruder</span>
        </div>
      </div>
    </div>
  </aside>

  <main class="flex-1 min-w-0">
    {@inner_content}
  </main>
</div>
