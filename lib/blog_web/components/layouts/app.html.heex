<.flash_group flash={@flash} />

<header class="py-4">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl flex justify-between">
      <div>
        <a href="/" class="flex items-center space-x-3">
          <img class="w-6 h-6 block rounded-full object-cover" src={~p"/images/my-face-new.jpg"} />
          <span class="font-fancy">danbruder</span>
        </a>
      </div>
      <div>
        <a href="/blog/about" class="group relative">
          <span class="inline-block">👋🏻</span>
          <span class="font-fancy text-sm">about me</span>
        </a>
      </div>
    </div>
  </div>
</header>

<div class="flex-grow">
  {@inner_content}
</div>

<footer class="mt-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl">
      <div class="flex justify-between items-center text-sm py-6 text-zinc-500">
        <span>&copy; {Date.utc_today().year} Dan Bruder</span>
      </div>
    </div>
  </div>
</footer>

<div
  :if={assigns[:viewer_count]}
  class="fixed bottom-4 right-4 z-50 flex items-center gap-2 rounded-full bg-zinc-900/90 border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 shadow-lg backdrop-blur"
>
  <span class="relative flex h-2 w-2">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
    <span class="relative inline-flex h-2 w-2 rounded-full bg-sky-400"></span>
  </span>
  {@viewer_count} {if @viewer_count == 1, do: "viewer", else: "viewers"}
</div>
